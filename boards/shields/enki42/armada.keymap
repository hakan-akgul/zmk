#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include <dt-bindings/zmk/ext_power.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <220>; };
&mt { quick_tap_ms = <220>; };

/ {
    macros {

    };
};
/ {
    keymap {
        compatible = "zmk,keymap";
        default_layer {
            bindings = <
                                  &kp 1 &kp 2 &kp 3 &kp 4 &kp 5      &kp 6 &kp 7 &kp 8 &kp 9 &kp 0    
                         &kp ESC  &kp Q &kp W &kp E &kp R &kp T      &kp Y &kp U &kp I &kp O &kp P  &kp BSPC 
                         &kp TAB  &kp A &kp S &kp D &kp F &kp G      &kp H &kp J &kp K &kp L &kp AT &kp RET
                &kp LALT &kp LALT &kp Z &kp X &kp C &kp V &kp B      &kp N &kp M       &kp UP 
                &kp LCMD &kp LCMD            &kp LCTRL &kp LALT      &kp SPACE &kp LEFT &kp DOWN &kp RIGHT 
            >;
        };
    };
};
